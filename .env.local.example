# AI OS Academy — Phase 1 keys.
# Copy this file to ".env.local" (same folder) and paste your real values.
# Never commit .env.local — it holds secrets. (.gitignore already ignores it.)

# ---- Supabase (database + login) ----
# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Keep this one SECRET (server-only):
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Razorpay (payments, TEST MODE) ----
# From Razorpay Dashboard -> Settings -> API Keys (with Test Mode ON)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR-RAZORPAY-TEST-SECRET

# ---- Academy / GST (your business details) ----
NEXT_PUBLIC_ACADEMY_GSTIN=19ABCFA0000A1Z0
NEXT_PUBLIC_ACADEMY_STATE=West Bengal
