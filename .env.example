# ---- Supabase (create a project at supabase.com for the LMS) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; never expose to the client

# ---- Razorpay (Dashboard > Settings > API Keys; use TEST keys first) ----
RAZORPAY_KEY_ID=                  # rzp_test_xxxx
RAZORPAY_KEY_SECRET=              # server-only
RAZORPAY_WEBHOOK_SECRET=          # set when you add the webhook in Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=      # same as RAZORPAY_KEY_ID, for the client widget

# ---- Seller details on the GST invoice ----
NEXT_PUBLIC_SELLER_GSTIN=         # Aikigai Edtech LLP GSTIN (required before charging GST)
